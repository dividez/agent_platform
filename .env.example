# Application
NODE_ENV=development
WEB_PORT=3000
API_PORT=8787
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
# Optional second-level deployment path, for example /agent-platform.
PUBLIC_BASE_PATH=
NEXT_PUBLIC_WEB_BASE_PATH=
API_BASE_PATH=

# Database provider switching: postgres | mysql | sqlite
DATABASE_PROVIDER=postgres
DATABASE_URL=postgres://agent:agent@localhost:5432/agent_platform
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_MIGRATIONS_ENABLED=true
DATABASE_MIGRATIONS_RUN_ON_STARTUP=false
DATABASE_MIGRATIONS_TABLE=agent_platform_migrations
DATABASE_MIGRATIONS_DIR=migrations/sql/postgres

# PostgreSQL local development
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent_platform
POSTGRES_PORT=5432

# MySQL local development (enable with: docker compose --profile mysql up)
MYSQL_ROOT_PASSWORD=agent-root
MYSQL_DATABASE=agent_platform
MYSQL_USER=agent
MYSQL_PASSWORD=agent
MYSQL_PORT=3306
MYSQL_IMAGE=mysql:8.4
# DATABASE_PROVIDER=mysql
# DATABASE_URL=mysql://agent:agent@localhost:3306/agent_platform
# DATABASE_MIGRATIONS_DIR=migrations/sql/mysql

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_PORT=7233

# Vector store provider switching: pgvector | qdrant | milvus | chroma | pinecone | weaviate
VECTOR_STORE_PROVIDER=pgvector
VECTOR_STORE_ENDPOINT=http://localhost:6333
VECTOR_STORE_COLLECTION=agent_memory
VECTOR_STORE_DIMENSION=1536
VECTOR_STORE_NAMESPACE=default
VECTOR_STORE_API_KEY=
VECTOR_STORE_DATABASE_URL=postgres://agent:agent@localhost:5432/agent_platform
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_IMAGE=qdrant/qdrant:latest

# Object storage provider switching: minio | s3 | gcs | azure-blob | filesystem
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=agent-platform
OBJECT_STORAGE_ACCESS_KEY_ID=agent
OBJECT_STORAGE_SECRET_ACCESS_KEY=agent-password
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_BASE_PATH=artifacts
MINIO_ROOT_USER=agent
MINIO_ROOT_PASSWORD=agent-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_IMAGE=minio/minio:latest

# Sandbox
SANDBOX_PROVIDER=docker
